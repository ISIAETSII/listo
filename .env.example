# Copia este fichero a `.env` y ajusta los valores.
# El fichero `.env` contiene contraseñas y NO se sube al repositorio (ver .gitignore).

# Clave con la que Flask firma las sesiones y los tokens CSRF. Cámbiala.
SECRET_KEY=cambia-esta-clave

# Conexión a MariaDB desde tu máquina.
# Con Docker, MARIADB_PORT es también el puerto en el que se publica el contenedor de la base de datos.
MARIADB_HOSTNAME=localhost
MARIADB_PORT=3306
MARIADB_DATABASE=listo_db
MARIADB_USER=listo_user
MARIADB_PASSWORD=listo_password

# Solo lo usa el contenedor de MariaDB de docker compose.
MARIADB_ROOT_PASSWORD=root

# Puerto en el que docker compose publica la aplicación web (localhost, puerto WEB_PORT).
WEB_PORT=5000

# Solo para producción (docker-compose.prod.yml): prefijo de URL si la aplicación
# no se sirve en la raíz del dominio (por ejemplo, /listo). Vacío si se sirve en la raíz.
URL_PREFIX=
